---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import CookieNotice from '../components/CookieNotice.astro';
import { SITE, FAQ } from '../config/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  includeFaqSchema?: boolean;
}

const {
  title,
  description = SITE.description,
  canonical = new URL(Astro.url.pathname, SITE.url).href,
  includeFaqSchema = false,
} = Astro.props;

const fullTitle =
  title === SITE.name ? title : `${title} | ${SITE.name}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  sameAs: [SITE.social.instagram],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.filter(f => f.a).map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#122f35" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {includeFaqSchema && faqSchema.mainEntity.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}

    <!-- Preconnect -->
    <link rel="preconnect" href="https://img.youtube.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap"
    />

    <!-- Transiciones entre páginas: la cabecera y el pie son los mismos en
         todo el sitio, así que al navegar se funden en vez de parpadear. -->
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
    <CookieNotice />
    <script>
      /* Scroll suave (Lenis, ~3 KB). Es lo que más cambia la sensación de la
         página por menos peso. Tres cautelas:
         - No se activa con prefers-reduced-motion: secuestrar el scroll a
           quien ha pedido menos movimiento sería justo lo contrario.
         - No toca los scrollers internos. El carrusel de servicios se arrastra
           y se desplaza por su cuenta; `prevent` deja pasar la rueda ahí.
         - Se destruye antes de cada transición de página y el bucle rAF vive
           una sola vez, para que navegar no acumule instancias. */
      import Lenis from 'lenis';

      let lenis = null;
      let bucleArrancado = false;

      function initLenis() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;

        lenis?.destroy();
        lenis = new Lenis({
          duration: 1.05,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          syncTouch: false, // en móvil se deja el scroll nativo del sistema
          // Sin esto Lenis se come los enlaces de ancla: la navegación de la
          // cabecera cambiaba el hash y la página no se movía.
          anchors: { offset: 0 },
          prevent: (node) => node.classList?.contains('svc-scroll'),
        });

        if (!bucleArrancado) {
          bucleArrancado = true;
          const raf = (t) => {
            lenis?.raf(t);
            requestAnimationFrame(raf);
          };
          requestAnimationFrame(raf);
        }
      }

      document.addEventListener('astro:page-load', initLenis);
      document.addEventListener('astro:before-swap', () => {
        lenis?.destroy();
        lenis = null;
      });
    </script>

    <script>
      /* Un único observador para todo el sitio. Antes había dos: este y otro
         dentro de index.astro, observando `.reveal` en paralelo. Acepta las
         dos convenciones para no tocar el marcado de las páginas.
         Se re-ejecuta en cada navegación porque con ClientRouter los scripts
         de página no vuelven a correr solos. */
      function initReveal() {
        const root = document.documentElement;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        root.classList.toggle('js', !reduce);

        const items = document.querySelectorAll('[data-reveal], .reveal');
        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-in', 'in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in', 'in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -8% 0px' }
        );
        items.forEach((el) => io.observe(el));

        /* Red de seguridad. El revelado parte de opacity:0, así que si el
           IntersectionObserver no dispara —navegador raro, pestaña en
           segundo plano, un entorno donde el observador no corre— la página
           se quedaría permanentemente invisible. Eso es un fallo mucho peor
           que perder una animación.
           Si tras el primer scroll no se ha revelado nada, damos por hecho
           que el observador no funciona y se muestra todo de golpe. Donde sí
           funciona, este código no llega a hacer nada. */
        let rescatado = false;
        const rescatar = () => {
          if (rescatado) return;
          rescatado = true;
          if (document.querySelectorAll('.reveal.in, [data-reveal].is-in').length === 0) {
            io.disconnect();
            items.forEach((el) => el.classList.add('is-in', 'in'));
          }
        };
        addEventListener('scroll', () => setTimeout(rescatar, 1200), { once: true, passive: true });
        setTimeout(rescatar, 1800);
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
