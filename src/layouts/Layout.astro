---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import CookieNotice from '../components/CookieNotice.astro';
import { SITE, FAQ } from '../config/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  includeFaqSchema?: boolean;
}

const {
  title,
  description = SITE.description,
  canonical = new URL(Astro.url.pathname, SITE.url).href,
  includeFaqSchema = false,
} = Astro.props;

const fullTitle =
  title === SITE.name ? title : `${title} | ${SITE.name}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  sameAs: [SITE.social.instagram],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.filter(f => f.a).map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#122f35" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {includeFaqSchema && faqSchema.mainEntity.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}

    <!-- Preconnect -->
    <link rel="preconnect" href="https://img.youtube.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap"
    />

    <!-- Transiciones entre páginas: la cabecera y el pie son los mismos en
         todo el sitio, así que al navegar se funden en vez de parpadear. -->
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
    <CookieNotice />
    <script>
      /* MOTOR DE ANIMACIÓN
         GSAP con ScrollTrigger y SplitText sobre el scroll NATIVO. Se probó
         una librería de scroll suave y se descartó: el cliente prefiere el
         scroll del navegador. Menos peso y una dependencia menos que pueda
         pelearse con las anclas o con el táctil.

         Nada se activa con prefers-reduced-motion.

         Regla del brief: NO se anima todo. Solo titulares, fotografía y la
         palabra del hero. Animar cada elemento delata una web hecha con IA. */
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { SplitText } from 'gsap/SplitText';

      gsap.registerPlugin(ScrollTrigger, SplitText);

      function initMotor() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;
        pestanas();
        animaciones();
      }

      /* Cursor deslizante del menú: sigue al enlace bajo el ratón y, al salir,
         vuelve al de la sección visible. Sin librería. */
      function pestanas() {
        document.querySelectorAll('.nav-links').forEach((lista) => {
          const enlaces = [...lista.querySelectorAll('a')];
          if (!enlaces.length) return;
          let activo = enlaces[0];

          const mover = (el, visible = true) => {
            lista.style.setProperty('--tab-x', el.offsetLeft + 'px');
            lista.style.setProperty('--tab-w', el.offsetWidth + 'px');
            lista.style.setProperty('--tab-o', visible ? '1' : '0');
          };

          enlaces.forEach((a) => {
            a.addEventListener('mouseenter', () => mover(a));
            a.addEventListener('focus', () => mover(a));
          });
          lista.addEventListener('mouseleave', () => mover(activo, activo !== enlaces[0]));

          /* Solo anclas de esta misma página: en las interiores los enlaces
             son '/#servicios' y querySelector con eso lanza SyntaxError. */
          const secciones = enlaces
            .map((a) => {
              const href = a.getAttribute('href') || '';
              if (!href.startsWith('#') || href.length < 2) return null;
              return { a, sec: document.querySelector(href) };
            })
            .filter((x) => x && x.sec);

          if (secciones.length && 'IntersectionObserver' in window) {
            const io = new IntersectionObserver((entradas) => {
              entradas.forEach((e) => {
                if (!e.isIntersecting) return;
                const par = secciones.find((x) => x.sec === e.target);
                if (par) { activo = par.a; mover(activo); }
              });
            }, { rootMargin: '-45% 0px -45% 0px' });
            secciones.forEach((x) => io.observe(x.sec));
          }
        });
      }

      function animaciones() {
        document.querySelectorAll('h1, h2').forEach((titulo) => {
          const split = new SplitText(titulo, {
            type: 'lines', linesClass: 'linea', mask: 'lines',
          });
          gsap.from(split.lines, {
            yPercent: 115, duration: 1.05, ease: 'expo.out', stagger: 0.09,
            scrollTrigger: { trigger: titulo, start: 'top 88%', once: true },
          });
        });

        document.querySelectorAll('.band-media img, .vid-media, .cta-media img')
          .forEach((el) => {
            gsap.fromTo(el, { yPercent: -6 }, {
              yPercent: 6, ease: 'none',
              scrollTrigger: {
                trigger: el.closest('section') || el,
                start: 'top bottom', end: 'bottom top', scrub: true,
              },
            });
          });

        /* 4 · El bloque de color de la palabra destacada se despliega de
           izquierda a derecha, justo después de que su línea se revele. */
        document.querySelectorAll('.destaca').forEach((el) => {
          gsap.fromTo(el, { '--sx': 0 }, {
            '--sx': 1, duration: 0.75, ease: 'expo.out', delay: 0.35,
            scrollTrigger: { trigger: el, start: 'top 88%', once: true },
          });
        });

        const letras = document.querySelectorAll('.hero-word span');
        if (letras.length) {
          gsap.from(letras, {
            yPercent: 60, opacity: 0, duration: 1.2, ease: 'expo.out',
            stagger: 0.055, delay: 0.15,
          });
        }
      }

      document.addEventListener('astro:page-load', initMotor);
      document.addEventListener('astro:before-swap', () => {
        ScrollTrigger.getAll().forEach((st) => st.kill());
      });
    </script>

    <script>
      /* Un único observador para todo el sitio. Antes había dos: este y otro
         dentro de index.astro, observando `.reveal` en paralelo. Acepta las
         dos convenciones para no tocar el marcado de las páginas.
         Se re-ejecuta en cada navegación porque con ClientRouter los scripts
         de página no vuelven a correr solos. */
      function initReveal() {
        const root = document.documentElement;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        root.classList.toggle('js', !reduce);

        const items = document.querySelectorAll('[data-reveal], .reveal');
        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-in', 'in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in', 'in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -8% 0px' }
        );
        items.forEach((el) => io.observe(el));

        /* Red de seguridad. El revelado parte de opacity:0, así que si el
           IntersectionObserver no dispara —navegador raro, pestaña en
           segundo plano, un entorno donde el observador no corre— la página
           se quedaría permanentemente invisible. Eso es un fallo mucho peor
           que perder una animación.
           Si tras el primer scroll no se ha revelado nada, damos por hecho
           que el observador no funciona y se muestra todo de golpe. Donde sí
           funciona, este código no llega a hacer nada. */
        let rescatado = false;
        const rescatar = () => {
          if (rescatado) return;
          rescatado = true;
          if (document.querySelectorAll('.reveal.in, [data-reveal].is-in').length === 0) {
            io.disconnect();
            items.forEach((el) => el.classList.add('is-in', 'in'));
          }
        };
        addEventListener('scroll', () => setTimeout(rescatar, 1200), { once: true, passive: true });
        setTimeout(rescatar, 1800);
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
