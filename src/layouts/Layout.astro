---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import CookieNotice from '../components/CookieNotice.astro';
import { SITE, FAQ } from '../config/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  includeFaqSchema?: boolean;
}

const {
  title,
  description = SITE.description,
  canonical = new URL(Astro.url.pathname, SITE.url).href,
  includeFaqSchema = false,
} = Astro.props;

const fullTitle =
  title === SITE.name ? title : `${title} | ${SITE.name}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  sameAs: [SITE.social.instagram],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.filter(f => f.a).map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#122f35" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {includeFaqSchema && faqSchema.mainEntity.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}

    <!-- Preconnect -->
    <link rel="preconnect" href="https://img.youtube.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap"
    />

    <!-- Transiciones entre páginas: la cabecera y el pie son los mismos en
         todo el sitio, así que al navegar se funden en vez de parpadear. -->
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
    <CookieNotice />
    <script>
      /* MOTOR DE ANIMACIÓN
         Lenis para el scroll suave y GSAP (ScrollTrigger + SplitText) para la
         coreografía. Van juntos a propósito: si cada uno lee el scroll por su
         cuenta se desincronizan y los disparadores se van de sitio. Por eso
         Lenis avisa a ScrollTrigger en cada scroll y GSAP conduce el bucle de
         fotogramas, en lugar de tener dos bucles compitiendo.

         Nada de esto se activa con prefers-reduced-motion: ni scroll
         secuestrado ni animaciones. La página queda quieta y completa.

         Regla que se mantiene del brief: NO se anima todo. Solo los titulares
         (revelado por línea), la fotografía (profundidad al desplazar) y la
         palabra del hero. Animar cada elemento es el tell de web hecha con IA. */
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { SplitText } from 'gsap/SplitText';

      gsap.registerPlugin(ScrollTrigger, SplitText);

      let lenis = null;

      function initMotor() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;

        lenis?.destroy();
        lenis = new Lenis({
          duration: 1.05,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          syncTouch: false,
          anchors: { offset: 0 },
          prevent: (node) => node.classList?.contains('svc-scroll'),
        });

        /* Un solo reloj: GSAP conduce y Lenis se engancha. Dos bucles rAF
           independientes producen micro-desfases visibles. */
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add(tiempoGsap);
        gsap.ticker.lagSmoothing(0);

        animaciones();
      }

      function tiempoGsap(time) {
        lenis?.raf(time * 1000);
      }

      function animaciones() {
        /* 1 · Titulares: se revelan línea a línea desde detrás de su propia
           caja. El estado inicial lo pone GSAP en tiempo de ejecución, nunca
           el CSS: si el JavaScript fallara, los titulares seguirían visibles. */
        document.querySelectorAll('h1, h2').forEach((titulo) => {
          const split = new SplitText(titulo, {
            type: 'lines',
            linesClass: 'linea',
            mask: 'lines',
          });
          gsap.from(split.lines, {
            yPercent: 115,
            duration: 1.05,
            ease: 'expo.out',
            stagger: 0.09,
            scrollTrigger: { trigger: titulo, start: 'top 88%', once: true },
          });
        });

        /* 2 · Fotografía: se desplaza más despacio que la página. Da
           profundidad sin parallax de fondo, que siempre se ve barato. */
        document.querySelectorAll('.band-media img, .vid-media, .cta-media img')
          .forEach((el) => {
            gsap.fromTo(el, { yPercent: -6 }, {
              yPercent: 6,
              ease: 'none',
              scrollTrigger: {
                trigger: el.closest('section') || el,
                start: 'top bottom',
                end: 'bottom top',
                scrub: true,
              },
            });
          });

        /* 3 · La palabra del hero entra letra a letra al cargar. Una sola vez,
           en el primer pantallazo, y nada más en toda la página. */
        const letras = document.querySelectorAll('.hero-word span');
        if (letras.length) {
          gsap.from(letras, {
            yPercent: 60,
            opacity: 0,
            duration: 1.2,
            ease: 'expo.out',
            stagger: 0.055,
            delay: 0.15,
          });
        }
      }

      document.addEventListener('astro:page-load', initMotor);
      document.addEventListener('astro:before-swap', () => {
        ScrollTrigger.getAll().forEach((st) => st.kill());
        gsap.ticker.remove(tiempoGsap);
        lenis?.destroy();
        lenis = null;
      });
    </script>

    <script>
      /* Un único observador para todo el sitio. Antes había dos: este y otro
         dentro de index.astro, observando `.reveal` en paralelo. Acepta las
         dos convenciones para no tocar el marcado de las páginas.
         Se re-ejecuta en cada navegación porque con ClientRouter los scripts
         de página no vuelven a correr solos. */
      function initReveal() {
        const root = document.documentElement;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        root.classList.toggle('js', !reduce);

        const items = document.querySelectorAll('[data-reveal], .reveal');
        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-in', 'in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in', 'in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -8% 0px' }
        );
        items.forEach((el) => io.observe(el));

        /* Red de seguridad. El revelado parte de opacity:0, así que si el
           IntersectionObserver no dispara —navegador raro, pestaña en
           segundo plano, un entorno donde el observador no corre— la página
           se quedaría permanentemente invisible. Eso es un fallo mucho peor
           que perder una animación.
           Si tras el primer scroll no se ha revelado nada, damos por hecho
           que el observador no funciona y se muestra todo de golpe. Donde sí
           funciona, este código no llega a hacer nada. */
        let rescatado = false;
        const rescatar = () => {
          if (rescatado) return;
          rescatado = true;
          if (document.querySelectorAll('.reveal.in, [data-reveal].is-in').length === 0) {
            io.disconnect();
            items.forEach((el) => el.classList.add('is-in', 'in'));
          }
        };
        addEventListener('scroll', () => setTimeout(rescatar, 1200), { once: true, passive: true });
        setTimeout(rescatar, 1800);
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
