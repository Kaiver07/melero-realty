---
const nav = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#proceso', label: 'Proceso' },
  { href: '/#comparativa', label: 'Comparativa' },
  { href: '/#equipo', label: 'Equipo' },
  { href: '/#faq', label: 'FAQ' },
];
---

<header
  class="sticky top-0 z-50"
  style="background: var(--color-bg); border-bottom: 2px solid var(--color-divider)"
>
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 py-3.5 flex items-center gap-10">

    <a
      href="/"
      style="font-family: var(--font-heading); font-weight: 800; font-size: 15px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text); text-decoration: none"
    >
      Melero Realty
    </a>

    <nav id="nav-links" class="hidden lg:flex items-center gap-7 ml-auto">
      {nav.map(({ href, label }) => (
        <a
          href={href}
          class="group relative"
          style="font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-text); text-decoration: none"
        >
          {label}
          <span class="absolute left-0 -bottom-1 h-px w-full origin-left scale-x-0 transition-transform duration-200 group-hover:scale-x-100" style="background: var(--color-accent)"></span>
        </a>
      ))}
    </nav>

    <a href="/contacto" class="btn btn-primary ml-auto lg:ml-0 whitespace-nowrap">
      Agendar diagnóstico
    </a>

    <button
      id="burger"
      class="lg:hidden p-2 -mr-2"
      style="color: var(--color-text)"
      aria-label="Abrir menú"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="burger-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        <path id="burger-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden" style="border-top: 2px solid var(--color-divider); background: var(--color-bg)">
    <ul class="max-w-[1440px] mx-auto px-4 py-4 flex flex-col gap-1">
      {nav.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="block py-2.5"
            style="font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text); text-decoration: none"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const burger = document.getElementById('burger')!;
  const menu   = document.getElementById('mobile-menu')!;
  const open   = document.getElementById('burger-open')!;
  const close  = document.getElementById('burger-close')!;

  burger.addEventListener('click', () => {
    const isOpen = !menu.classList.contains('hidden');
    menu.classList.toggle('hidden', isOpen);
    open.classList.toggle('hidden', !isOpen);
    close.classList.toggle('hidden', isOpen);
  });

  menu.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      open.classList.remove('hidden');
      close.classList.add('hidden');
    })
  );
</script>
