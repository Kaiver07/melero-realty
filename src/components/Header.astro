---
import { SITE } from '../config/site';

/* Cabecera de las páginas interiores.
   La home NO usa este componente: su navegación va dentro del hero, en
   transparente sobre la fotografía. Esta es la misma navegación —mismas
   fuentes, mismo tracking, mismos enlaces— pero sobre una banda sólida en
   #122f35, para que al pasar de la home a contacto no cambie el lenguaje.
   Los anclajes van a /#ancla porque desde aquí no existen en la página. */
const nav = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#proceso', label: 'Proceso' },
  { href: '/#equipo', label: 'Equipo' },
  { href: '/#faq', label: 'FAQ' },
];
---

<header class="site-hdr">
  <div class="wrap">
    <nav class="nav" aria-label="Principal">
      <a class="nav-brand" href="/">{SITE.name}</a>
      <ul class="nav-links">
        {nav.map((n) => (
          <li><a href={n.href}>{n.label}</a></li>
        ))}
      </ul>
      <a class="nav-mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </nav>
  </div>
</header>

<style is:global>
  .site-hdr {
    background: var(--ink);
    color: var(--white);
    padding-block: clamp(14px, 1.8vw, 22px);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  /* La lista de enlaces se oculta en móvil: el correo y la marca bastan
     para volver, y no vale la pena un menú desplegable en páginas que ya
     son un único documento. */
  @media (max-width: 860px) {
    .site-hdr .nav-links {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .site-hdr .nav-mail {
      display: none;
    }
  }
</style>
