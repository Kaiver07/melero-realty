---
import { SITE } from '../config/site';
const year = new Date().getFullYear();
---

<footer style="background: var(--color-ink)" class="mt-auto">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 py-10 grid grid-cols-1 sm:grid-cols-3 gap-6 items-center">
    <div style="font-family: var(--font-heading); font-weight: 800; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #f8f4f4">
      Melero Realty
    </div>
    <div style="font-size: 13px; color: rgba(248,244,244,.55)">
      {SITE.domain} · España &amp; EEUU
    </div>
    <div class="sm:text-right" style="font-size: 13px">
      <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" style="color: rgba(248,244,244,.55); text-decoration: none">Instagram</a>
    </div>
  </div>

  <div style="border-top: 2px solid rgba(248,244,244,.14)">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-2" style="font-size: 12px; color: rgba(248,244,244,.4)">
      <p>© {year} {SITE.name}. Todos los derechos reservados.</p>
      <div class="flex gap-4">
        <a href="/aviso-legal" style="color: rgba(248,244,244,.4); text-decoration: none">Aviso legal</a>
        <a href="/politica-de-privacidad" style="color: rgba(248,244,244,.4); text-decoration: none">Privacidad</a>
        <a href="/politica-de-cookies" style="color: rgba(248,244,244,.4); text-decoration: none">Cookies</a>
      </div>
    </div>
  </div>
</footer>
