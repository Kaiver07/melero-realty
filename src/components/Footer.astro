---
import { SITE } from '../config/site';

/* Pie compartido por todas las páginas. La home lo usa igual que las
   interiores: si cambia aquí, cambia en todo el sitio.
   Los enlaces de navegación apuntan a /#ancla y no a #ancla, para que
   funcionen también desde contacto, sobre-nosotros y las legales. */
const year = new Date().getFullYear();

const nav = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#proceso', label: 'Proceso' },
  { href: '/#equipo', label: 'Equipo' },
  { href: '/#faq', label: 'Preguntas' },
];
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-top">
      <div>
        <p class="footer-brand">MELERO<span>.</span></p>
        <p>
          Captación de leads para negocios inmobiliarios en activo.
          Exclusividad por zona.
        </p>
      </div>
      <div>
        <h4>Navegación</h4>
        <ul>
          {nav.map((n) => (
            <li><a href={n.href}>{n.label}</a></li>
          ))}
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </div>
      <div>
        <h4>Contacto</h4>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.url}>{SITE.domain}</a></li>
          <li>
            <a href={SITE.whatsapp} target="_blank" rel="noopener">WhatsApp {SITE.telefono}</a>
          </li>
          <li>
            <a href={SITE.social.instagram} target="_blank" rel="noopener">Instagram @melero.realty</a>
          </li>
          <li>
            <a href={SITE.social.linkedin} target="_blank" rel="noopener">LinkedIn de Valeria Melero</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {year} {SITE.name}. Todos los derechos reservados.</span>
      <span>
        <a href="/aviso-legal">Aviso legal</a>
        <a href="/politica-de-privacidad">Privacidad</a>
        <a href="/politica-de-cookies">Cookies</a>
        <button class="ck-reabrir" type="button" data-cookies-reabrir>Preferencias</button>
      </span>
    </div>
  </div>
</footer>

<style is:global>
  /* Los legales viven en la línea inferior: separados y en tono menor. */
  .footer-bottom a {
    color: var(--muted-dark);
    text-decoration: none;
    margin-left: 1.4rem;
    transition: color 0.2s var(--ease);
  }
  .footer-bottom a:first-child {
    margin-left: 0;
  }
  .footer-bottom a:hover {
    color: var(--white);
  }
  @media (max-width: 560px) {
    .footer-bottom a {
      margin-left: 0;
      margin-right: 1.2rem;
    }
  }
</style>
