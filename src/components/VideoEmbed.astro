---
interface Props { videoId: string; title?: string; poster?: string; ratio?: string; }
/* `poster` permite servir la miniatura desde el propio dominio. Hace falta
   para los Shorts: la miniatura que da YouTube viene con relleno borroso a
   los lados para forzarla a 16:9, y el contenido real es solo la franja
   central. Aquí se pasa ya recortada.
   `ratio` porque un Short es 9:16 y no cabe en el marco horizontal. */
const { videoId, title = 'Ver vídeo', poster, ratio = '16/9' } = Astro.props;
const thumb = poster ?? `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`;
---

<div
  class="yt-facade"
  data-video-id={videoId}
  style={`aspect-ratio:${ratio}`}
  role="button"
  tabindex="0"
  aria-label={title}
>
  <img src={thumb} alt={title} loading="lazy" decoding="async" />
  <div class="yt-play">
    <span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--color-ink)"><polygon points="6 4 20 12 6 20"></polygon></svg>
      Ver el vídeo
    </span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.yt-facade').forEach(el => {
    const activate = () => {
      const id = el.dataset.videoId;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0`;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
      el.innerHTML = '';
      el.appendChild(iframe);
    };
    el.addEventListener('click', activate);
    el.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') activate(); });
  });
</script>
