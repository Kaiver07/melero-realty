---
/* La portada de la home (desde el 14/11/2026): vídeo a sangre hasta el
   borde de la pantalla, en el esquema de españoladetelefonia.es, con la
   cabecera transparente por encima (Header.astro, sobreVideo). Encima del
   vídeo, el titular, el apoyo y la píldora de reserva.
   El vídeo son ocho tomas de 3,5 s (Madrid, Barcelona, Sevilla, Benidorm,
   Marbella, Dubái, Santo Domingo y Lauterbrunnen) unidas con fundidos de
   0,4 s: 25 s en bucle, sin sonido. En public/video, en MP4 de 1920 px
   (4,8 MB) y de 1280 px (3 MB). En WebM pesaba más: no se sirve.
   Lo primero que se pinta es el fotograma fijo (<img>, que es lo que mide
   Google como LCP); el vídeo se pide después y aparece encima cuando ya
   está reproduciéndose. Con movimiento reducido o ahorro de datos no se
   pide: se queda el fotograma.
   La portada anterior, «la señal» (el muro de mensajes y la ficha del
   lead), está en el historial de git hasta el commit 7a8558c. */
import { HERO } from '../config/site';
import Reserva from './Reserva.astro';
---

<section class="portada" id="top" aria-labelledby="portada-t">
  <div class="portada-fondo" aria-hidden="true">
    <img class="portada-poster" src="/video/portada-poster.webp" srcset="/video/portada-poster-1280.webp 1280w, /video/portada-poster.webp 1920w" sizes="100vw" alt="" width="1920" height="1080" fetchpriority="high" decoding="async">
    <video class="portada-video" muted loop playsinline preload="none" tabindex="-1" disablepictureinpicture>
      <source src="/video/portada-1280.mp4" type="video/mp4" media="(max-width: 1280px)">
      <source src="/video/portada-1920.mp4" type="video/mp4">
    </video>
    <div class="portada-velo"></div>
  </div>

  <div class="portada-in">
    <p class="portada-kicker">{HERO.kicker}</p>
    <h1 id="portada-t">{HERO.titulo}</h1>
    <p class="portada-apoyo">{HERO.apoyo}</p>
    <Reserva />
  </div>
</section>

<script>
  /* El vídeo arranca sólo si hay movimiento, no se ha pedido ahorro de
     datos y la portada está a la vista; se para al salir de ella o al
     ocultar la pestaña (ningún bucle de adorno sigue fuera de vista). Si el
     navegador no deja reproducir, se queda el fotograma y no pasa nada. */
  document.addEventListener('astro:page-load', () => {
    const portada = document.querySelector<HTMLElement>('.portada');
    const video = portada?.querySelector<HTMLVideoElement>('.portada-video');
    if (!portada || !video) return;
    const conexion = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || conexion?.saveData) return;

    let visible = true;
    const control = new AbortController();
    const intentar = () => {
      if (visible && !document.hidden) video.play().catch(() => {});
      else video.pause();
    };
    video.addEventListener('playing', () => portada.classList.add('portada--video'), { once: true, signal: control.signal });
    document.addEventListener('visibilitychange', intentar, { signal: control.signal });
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(([e]) => { visible = e.isIntersecting; intentar(); }, { threshold: 0.05 });
      obs.observe(portada);
      control.signal.addEventListener('abort', () => obs.disconnect());
    }
    // Se pide cuando la página ya ha cargado: el vídeo no compite con el
    // fotograma, la fuente y los estilos.
    const arrancar = () => { video.preload = 'auto'; intentar(); };
    if (document.readyState === 'complete') arrancar();
    else window.addEventListener('load', arrancar, { once: true, signal: control.signal });

    document.addEventListener('astro:before-swap', () => { video.pause(); control.abort(); }, { once: true });
  });
</script>
