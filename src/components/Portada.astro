---
/* La portada de la home: «la señal» (desde el 24/10/2026; antes, el
   «muro en vivo» del 21/10/2026, del que sale).
   La plancha verde; a la izquierda, el titular y la reserva; de fondo,
   hasta el borde de la pantalla, la foto del piso y columnas de mensajes de
   curioso que suben sin parar, como un móvil que no deja de sonar; y
   encima, la única ficha blanca: el lead que sí encaja. Cada pocos
   segundos, entre el ruido, un mensaje se enciende en teal con un lead y la
   ficha pasa a ese lead (rotan los tres de HERO.leads). El texto y la
   ficha van dentro de la caja de la página (--maxw), para que en pantallas
   anchas no se desparrame. docs/prompt-diseno.md.
   Desde el 24/10/2026 la portada termina en la reserva: los logotipos y la
   reseña van justo debajo, en el testimonio (Testimonio.astro).
   - piso: la portada anterior (foto del piso a sangre y bandeja de
     contactos). Se queda para poder volver a ella cambiando una palabra. */
import { SITE, HERO } from '../config/site';
import { srcsetDe } from '../lib/imagenes';
import Franja from './Franja.astro';
import Reserva from './Reserva.astro';
import FichaLead from './FichaLead.astro';

interface Props {
  variante?: 'muro' | 'piso';
}
const { variante = 'muro' } = Astro.props;

/* Todos los botones de reserva van al pago del Diagnóstico (Stripe), que
   al cobrar redirige a Calendly. Ver SITE.pagoDiagnosticoUrl. */
const pago = SITE.pagoDiagnosticoUrl;

const mensajes = HERO.bandeja.mensajes;
/* Nueve columnas con las doce frases, cada una empezando en otra, para que
   no se lea como la misma lista repetida. Con doce (repetidas, 24) la
   columna mide más que la portada y el muro llega hasta abajo; con seis se
   acababa a media altura. Caben las columnas que caben: el resto lo
   recorta el muro, también en pantallas muy anchas. */
const columnas = [0, 2, 5, 7, 9, 3, 10, 6, 1].map((ini) => HERO.muro.map((_, k) => HERO.muro[(ini + k) % HERO.muro.length]));
---

{/* ================= 1 · HERO ================= */}
<header class:list={['hero', `hero--${variante}`]} id="top" data-cortos={variante === 'muro' ? JSON.stringify(HERO.leads.map((l) => l.corto)) : undefined}>
  {variante === 'piso' && (
    <>
      <div class="hero-media"><img src="/images/hero-piso.webp" srcset={srcsetDe('/images/hero-piso.webp', 1672, [800, 1200])} sizes="100vw" alt="Interior de una vivienda vacía con luz rasante entrando por el ventanal, grabada con un móvil montado en un trípode" width="1672" height="941" fetchpriority="high" decoding="async"></div>
      <div class="hero-veil" aria-hidden="true"></div>
      <div class="hero-scrim" aria-hidden="true"></div>
    </>
  )}

  <nav class="nav" aria-label="Principal">
    <a class="nav-brand" href="#top">Melero Realty</a>
    <ul class="nav-links">
      <li><a href="#planes">Planes</a></li>
      <li><a href="#proceso">Proceso</a></li>
      <li><a href="#equipo">Equipo</a></li>
      <li><a href="#faq">FAQ</a></li>
      <li class="nav-keep"><a href="/blog/">Blog</a></li>
    </ul>
    {/* Antes, el correo. Desde el 19/10/2026, el botón al Diagnóstico: el
         correo sigue en el cierre y en el pie. */}
    <a class="nav-mail" data-cta="menu" href={pago} target="_blank" rel="noopener">Diagnóstico</a>
  </nav>

  {variante === 'muro' && (
    <div class="hero-inner mv">
      <div class="mv-texto">
        <h1>{HERO.titulo}</h1>
        <p class="hero-support">{HERO.apoyo}</p>
        <Reserva />
      </div>
      {/* Los fondos (foto y muro) se colocan respecto a la portada entera:
           esta columna es estática a propósito. En la columna sólo queda la
           ficha. */}
      <div class="mv-escena">
        <div class="mv-foto"><img src="/images/hero-piso.webp" srcset={srcsetDe('/images/hero-piso.webp', 1672, [800, 1200])} sizes="(max-width: 900px) 100vw, 60vw" alt="" width="1672" height="941" fetchpriority="high" decoding="async"></div>
        {/* El giro va en un envoltorio y no en cada columna: girada por
             separado, cada columna recortaba los mensajes por su borde. */}
        <div class="mv-muro" aria-hidden="true"><div class="mv-giro">
          {columnas.map((col, c) => (
            <div class="mv-col" style={`--c:${c}`}><div class="mv-pista">{[...col, ...col, ...col].map((t) => <span>{t}</span>)}</div></div>
          ))}
        </div></div>
        <FichaLead todas />
      </div>
    </div>
  )}

  {variante === 'piso' && (
    <div class="hero-inner">
      <div class="hero-spacer"></div>
      <div class="hero-word" aria-hidden="true"><span>M</span><span>E</span><span>L</span><span>E</span><span>R</span><span>O</span></div>
      <div class="hero-cuerpo">
        <div class="hero-izq">
          <div class="hero-copy">
            <p class="hero-kicker">{HERO.kicker}</p>
            <h1>{HERO.titulo}</h1>
            <p class="hero-support">{HERO.apoyo}</p>
          </div>
          <Reserva />
          <Franja />
        </div>
        <figure class="bandeja">
          <p class="bx-cab">{HERO.bandeja.titulo}</p>
          <ol class="bx-lista">
            {mensajes.map((m, i) => (
              <li class:list={['bx-msg', m.cualificado ? 'bx-msg--lead' : 'bx-msg--curioso']} style={`--i:${i}`}>
                <p class="bx-meta"><span class="bx-origen">{m.origen}</span><span class="bx-hora">{m.hora}</span></p>
                <p class="bx-texto">{m.texto}</p>
                {m.cualificado && <p class="bx-tag">{HERO.bandeja.etiqueta}</p>}
              </li>
            ))}
          </ol>
          <figcaption class="bx-nota">{HERO.bandeja.nota}</figcaption>
        </figure>
      </div>
    </div>
  )}
</header>

<script>
  /* La señal. Cada pocos segundos, un mensaje del muro que esté a la vista,
     y no debajo de la ficha, se enciende en teal con un lead, y la ficha
     pasa a ese lead. Con movimiento reducido no arranca: se ve la primera
     ficha y el muro quieto. Se para cuando la portada no se ve o la pestaña
     está oculta (Impeccable: ningún bucle de adorno sigue fuera de vista). */
  const portada = document.querySelector<HTMLElement>('.hero--muro');
  if (portada && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let visible = true;
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        portada.classList.toggle('en-pausa', !visible);
      }, { threshold: 0.05 }).observe(portada);
    }
    const cortos: string[] = JSON.parse(portada.dataset.cortos || '[]');
    const fichas = [...portada.querySelectorAll<HTMLElement>('.senal-ficha')];
    const muro = portada.querySelector<HTMLElement>('.mv-muro');
    const ficha = portada.querySelector<HTMLElement>('.senal');
    let n = 0;
    const tic = () => {
      if (visible && !document.hidden && muro && ficha && fichas.length) {
        n = (n + 1) % fichas.length;
        const m = muro.getBoundingClientRect(), f = ficha.getBoundingClientRect();
        const libres = [...muro.querySelectorAll<HTMLElement>('.mv-pista span')].filter((s) => {
          const r = s.getBoundingClientRect();
          const dentro = r.left > m.left + m.width * 0.28 && r.right < m.right - 20 && r.top > m.top + 150 && r.bottom < m.top + m.height * 0.72;
          const tapado = r.right > f.left - 12 && r.left < f.right + 12 && r.bottom > f.top - 12 && r.top < f.bottom + 12;
          return dentro && !tapado && !s.classList.contains('mv-luz');
        });
        const s = libres[Math.floor(Math.random() * libres.length)];
        if (s && cortos[n]) {
          const antes = s.textContent;
          s.textContent = cortos[n];
          s.classList.add('mv-luz');
          setTimeout(() => { s.classList.remove('mv-luz'); setTimeout(() => { s.textContent = antes; }, 450); }, 2200);
        }
        fichas.forEach((el, i) => {
          el.classList.toggle('es-activa', i === n);
          if (i === n) el.removeAttribute('aria-hidden'); else el.setAttribute('aria-hidden', 'true');
        });
      }
      setTimeout(tic, 4600);
    };
    setTimeout(tic, 3800);
  }
</script>

