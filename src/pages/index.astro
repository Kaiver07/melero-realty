---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import '../styles/home.css';
import { SITE, SERVICES, PROCESO, COMPARISON, TEAM, FAQ, SOCIAL } from '../config/site';
import { existsSync } from 'node:fs';

/* Solo se pintan las publicaciones cuya miniatura existe en disco. Instagram
   no permite descargarlas automáticamente, así que se aportan a mano y este
   filtro garantiza que una que falte no deje un hueco roto en la web. */
const SOCIAL_CON_IMAGEN = SOCIAL
  .map((item) => {
    const codigo = item.url.match(/\/(?:p|reel)\/([^/?]+)/)?.[1] ?? '';
    return { ...item, codigo, img: `/images/social/${codigo}.webp` };
  })
  .filter((item) => item.codigo && existsSync(`public${item.img}`));

/* Fotografía de los servicios, emparejada por índice con SERVICES.
   El copy vive en site.ts (fuente de verdad); aquí solo la imagen. */
const SERVICE_MEDIA = [
  { src: '/images/real-guiones.webp',    alt: 'El equipo de Melero Realty revisando guiones y campañas sobre la mesa', w: 900, h: 1200 },
  { src: '/images/real-set.webp',        alt: 'Set de grabación montado con la cámara en trípode',            w: 900, h: 1600 },
  { src: '/images/real-rodaje.webp',     alt: 'Valeria Melero grabando contenido en vídeo frente a la cámara', w: 900, h: 1351 },
  { src: '/images/svc-marca.webp',       alt: 'Un móvil muestra la cuadrícula de un perfil inmobiliario junto a fotografías impresas sobre la mesa', w: 900, h: 1125 },
  { src: '/images/svc-contenido.webp',   alt: 'Portátil con una línea de tiempo de edición de vídeo, auriculares y un calendario de contenidos a mano',  w: 900, h: 1125 },
  { src: '/images/svc-consultoria.webp', alt: 'Videollamada de seguimiento con un cuaderno de notas abierto al lado del portátil',                       w: 900, h: 1125 },
];
---

{/* El título era solo "Melero Realty": una marca que nadie busca todavía.
    Ahora nombra las dos intenciones por las que sí se busca esto, y la
    marca queda detrás. 59 caracteres, dentro de lo que Google muestra
    sin recortar. */}
<Layout title="Marketing inmobiliario y captación de leads" includeFaqSchema={true}>


<!-- ================= 1 · HERO ================= -->
<header class="hero" id="top">
  <div class="hero-media">
    <img src="/images/hero-piso.webp" alt="Interior de una vivienda vacía con luz rasante entrando por el ventanal, grabada con un móvil montado en un trípode" width="1672" height="941" fetchpriority="high" decoding="async">
  </div>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-scrim" aria-hidden="true"></div>

  <nav class="nav" aria-label="Principal">
    <a class="nav-brand" href="#top">Melero Realty</a>
    <ul class="nav-links">
      <li><a href="#servicios">Servicios</a></li>
      <li><a href="#proceso">Proceso</a></li>
      <li><a href="#equipo">Equipo</a></li>
      <li><a href="#faq">FAQ</a></li>
    </ul>
    <a class="nav-mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </nav>

  <div class="hero-inner">
    <div class="hero-spacer"></div>

    <div class="hero-word" aria-hidden="true"><span>M</span><span>E</span><span>L</span><span>E</span><span>R</span><span>O</span></div>

    <div class="hero-copy">
      <p class="hero-kicker">Marketing inmobiliario</p>
      <h1>Captación de leads para inmobiliarias <br>que ya están facturando.</h1>
      <p class="hero-support">Sistemas de captación de leads cualificados para negocios inmobiliarios en activo. Sin portales. Sin referidos. Sin curiosos.</p>
    </div>

    <!-- píldora de filtros: maquetada, sin lógica -->
    <div class="actionbar">
      <div class="ab-field">
        <span class="ab-label">Tipo de agencia</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5 8 10.5 12 6.5"/></svg>
      </div>
      <div class="ab-field">
        <span class="ab-label">Zona</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5 8 10.5 12 6.5"/></svg>
      </div>
      <div class="ab-field">
        <span class="ab-label">Facturación</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5 8 10.5 12 6.5"/></svg>
      </div>
      <a class="ab-btn" href={SITE.calendlyUrl} target="_blank" rel="noopener">Reservar diagnóstico</a>
    </div>

    <!-- Lo que cuesta pulsar el botón, dicho en el botón. Antes esto vivía
         en la cuarta pregunta de la FAQ, nueve secciones más abajo: quien
         dudaba se iba sin llegar a leerlo. -->
    <p class="ab-note">
      <strong>45 minutos</strong> de videollamada con Valeria. Sin coste y sin compromiso.
    </p>
  </div>
</header>

<main>

  <!-- ================= 6 · BANDA OSCURA ================= -->
  <section class="section band" aria-labelledby="band-t">
    <div class="wrap">
      <div class="band-grid">
        <div class="band-copy reveal">
          <p class="eyebrow eyebrow--dark">(01) El problema</p>
          <h2 id="band-t">Si el 80% de tus leads<br>vienen de un portal,<br>tienes un problema.</h2>
          <p>Un portal te alquila la demanda: el día que dejas de pagar, desaparece, y el contacto nunca llegó a ser tuyo. Nosotros construimos un canal dentro de tu marca que corre en paralelo, para que el lead llegue a tu nombre y sepas exactamente qué te cuesta cada cliente.</p>
          <!-- El remate desarma la objeción de verdad, que no es "el portal es
               malo" sino "no puedo permitirme soltarlo". Concesión en voz baja,
               petición en alto. -->
          <p class="band-pivot">
            <span>No te pedimos que dejes el portal.</span>
            Te pedimos que dejes de depender de él.
          </p>
        </div>

        <div class="band-media reveal">
          <img src="/images/meeting.webp" alt="Reunión de equipo en una oficina acristalada de tonos oscuros" width="1300" height="866" loading="lazy" decoding="async">
          <div class="float-cards">
            <article class="fcard">
              <div class="fcard-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
              </div>
              <h3>Exclusividad por zona</h3>
              <p>Una sola marca por área de captación. No abrimos una segunda cuenta en tu mercado.</p>
            </article>
            <article class="fcard">
              <div class="fcard-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M6.5 21V12"/><path d="M12 21V4.5"/><path d="M17.5 21v-6.5"/></svg>
              </div>
              <h3>Reporte semanal</h3>
              <p>Coste por lead y coste por cliente, cada semana. Nada de impresiones ni alcance.</p>
            </article>
            <article class="fcard">
              <div class="fcard-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.4 2.7-5.6 6-5.6"/><circle cx="17" cy="11.2" r="2.4"/><path d="M13.4 20c0-2.4 1.6-4 3.6-4s3.6 1.6 3.6 4"/></svg>
              </div>
              <h3>Acompañamiento 1:1</h3>
              <p>Comunicación directa con la CEO durante todo el contrato. Sin capas intermedias.</p>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 4 · SERVICIOS ================= -->
  <!-- (02) Vídeo. Va inmediatamente después de la declaración de intenciones:
       la página dice lo que hace y acto seguido lo dice la CEO en su propia
       voz, antes de entrar a enumerar servicios.
       Fachada de YouTube: solo se carga la miniatura y el iframe se inserta
       al pulsar. Sin JavaScript de framework. -->
  <section class="section section--paper vid" id="video" aria-labelledby="vid-t">
    <div class="wrap vid-grid reveal">
      <div class="vid-copy">
        <p class="eyebrow">(02) En vídeo</p>
        <h2 id="vid-t">¿Qué es <span class="destaca">realmente</span> Melero&nbsp;Realty?</h2>
        <p class="vid-by">Valeria Melero &mdash; CEO &amp; Founder</p>
        <a class="vid-cta" href={SITE.calendlyUrl} target="_blank" rel="noopener">
          Reservar diagnóstico
          <span aria-hidden="true">&#8594;</span>
        </a>
      </div>
      <div class="vid-media">
        <VideoEmbed
          videoId={SITE.youtubeId}
          poster="/images/video-poster.webp"
          ratio="9/16"
          title="¿Qué es realmente Melero Realty?"
        />
      </div>
    </div>
  </section>

  <!-- ================= 3 · INTRO ================= -->
  <section class="section section--white" aria-labelledby="intro-t">
    <div class="wrap">
      <div class="intro-grid reveal">
        <div class="intro-side">
          <p class="eyebrow">(03) El servicio</p>
          <p>Trabajamos con inmobiliarias en activo y con exclusividad por zona: una sola marca por área de captación.</p>
        </div>
        <div>
          <h2 id="intro-t" class="intro-big">Creamos sistemas de captación de leads cualificados para negocios inmobiliarios en activo. Diseñamos el recorrido completo, del primer clic a la llamada agendada, y lo ajustamos semana a semana según coste por lead y calidad real. <em>Sin portales. Sin referidos. Sin curiosos.</em></h2>
        </div>
      </div>
      <div class="intro-rule" aria-hidden="true"></div>
    </div>
  </section>

  <!-- ================= 8 · COMPARATIVA ================= -->
  <section class="section section--paper" aria-labelledby="cmp-t">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">(04) La diferencia</p>
        <h2 id="cmp-t" style="font-size:clamp(1.7rem,3.5vw,2.85rem);font-weight:600;margin-top:1.3rem;max-width:20ch;line-height:1.03">Lo que suele pasar, y lo que hacemos nosotros.</h2>

        <div class="cmp-head-row">
          <p class="cmp-h cmp-h--them">Otras agencias</p>
          <p class="cmp-h cmp-h--us">Melero Realty</p>
        </div>

        <div class="cmp">
        {COMPARISON.map((c) => (
          <>
            <div class="cmp-cell cmp-cell--them"><span class="cmp-tag">Otras agencias</span>{c.ellos}</div>
            <div class="cmp-cell cmp-cell--us"><span class="cmp-tag">Melero Realty</span>{c.nosotros}</div>
          </>
        ))}
        </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 7 · PROCESO ================= -->
  <section class="section proc" id="proceso" aria-labelledby="proc-t">
    <p class="proc-mark" aria-hidden="true">PROCESO</p>
    <div class="wrap">
      <div class="proc-head reveal">
        <p class="eyebrow eyebrow--dark">(05) Cómo trabajamos</p>
        <h2 id="proc-t">Cinco fases. Ninguna decorativa.</h2>
      </div>
      <ol class="steps reveal">
        {PROCESO.map((p) => (
          <li class="step">
            <span class="step-n">{p.step}</span>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--white svc" id="servicios" aria-labelledby="svc-t">
    <div class="wrap">
      <div class="svc-head reveal">
        <div>
          <p class="eyebrow">(06) Servicios</p>
          <h2 id="svc-t">Seis frentes, un solo objetivo: llamadas agendadas.</h2>
        </div>
        <div class="svc-head-right">
          <p class="lead" style="max-width:34ch">Cada pieza existe para reducir el coste por cliente, no para llenar un informe.</p>
        </div>
      </div>
    </div>

    <div class="wrap">
      <!-- Estructura que pide Embla: ventana > pista > diapositivas. -->
      <div class="svc-scroll" id="svcScroll" role="region" aria-label="Servicios, desplazamiento horizontal">
        <div class="svc-track">
        {SERVICES.map((sv, i) => (
          <article class="svc-card">
            <figure class="svc-fig">
              <img src={SERVICE_MEDIA[i].src} alt={SERVICE_MEDIA[i].alt}
                   width={SERVICE_MEDIA[i].w} height={SERVICE_MEDIA[i].h}
                   loading="lazy" decoding="async" />
            </figure>
            <span class="svc-index">{String(i + 1).padStart(2, '0')}</span>
            <h3>{sv.title}</h3>
            <p>{sv.desc}</p>
          </article>
        ))}
        </div>

      </div>
    </div>

    <div class="wrap">
      <div class="svc-bar" aria-hidden="true"><span class="svc-bar-fill" id="svcBar"></span></div>
      <div class="svc-foot">
        <a class="btn btn--dark" href={SITE.calendlyUrl} target="_blank" rel="noopener">Diagnóstico
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9.5 4l4 4-4 4"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= 5 · DATOS ================= -->
  <section class="section section--white" style="padding-top:0" aria-labelledby="facts-t">
    <div class="wrap">
      <h2 id="facts-t" class="brandline reveal">Hablamos de números, no de followers.</h2>
      <div class="facts reveal">
        <div class="fact">
          <p class="fact-num">A medida</p>
          <p>Cada sistema se dimensiona según la zona, el tipo de propiedades y el objetivo. El presupuesto sale del diagnóstico.</p>
        </div>
        <div class="fact">
          <p class="fact-num">6 meses</p>
          <p>Duración del contrato. Los primeros resultados llegan hacia los 20 días; antes de 3 meses no garantizamos nada.</p>
        </div>
        <div class="fact">
          <p class="fact-num">1 marca</p>
          <p>Exclusividad por zona. Si trabajamos contigo, no trabajamos con tu competencia directa.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 9 · EQUIPO ================= -->
  <section class="section section--paper" id="equipo" style="padding-bottom:0" aria-labelledby="team-t">
    <div class="wrap team-head reveal">
      <p class="eyebrow">(07) Equipo</p>
      <h2 id="team-t">Tres personas, sin capas intermedias.</h2>
    </div>
    <div class="wrap">
    <div class="team-grid">
      {TEAM.map((m) => (
        <figure class="member">
          <img src={m.photo} alt={`Retrato de ${m.name}, ${m.role} de Melero Realty`}
               width="1000" height="1250" loading="lazy" decoding="async" />
          <figcaption>
            <span class="member-name">{m.name}</span>
            <span class="member-role">{m.role}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    </div>
  </section>

  <!-- ================= SOCIAL ================= -->
  <!-- (08) Publicaciones. La sección solo existe si hay contenido en SOCIAL:
       una rejilla vacía sería peor que no tenerla. Las miniaturas son locales
       y cada tarjeta enlaza a Instagram; no hay script de terceros, así que
       no entra ni una cookie de seguimiento. -->
  {SOCIAL_CON_IMAGEN.length > 0 && (
  <section class="section section--white social" aria-labelledby="social-t">
    <div class="wrap">
      <div class="social-head reveal">
        <div>
          <p class="eyebrow">(08) Lo que publicamos</p>
          <h2 id="social-t">Contenido que filtra, no que rellena.</h2>
        </div>
        <a class="social-perfil" href={SITE.social.instagram} rel="noopener" target="_blank">
          Ver el perfil
          <span aria-hidden="true">&#8594;</span>
        </a>
      </div>

      <div class="social-grid reveal">
        {SOCIAL_CON_IMAGEN.map((item) => (
          <a class="social-item" href={item.url} target="_blank" rel="noopener">
            <img
              src={item.img}
              alt={item.alt}
              width="640" height="800" loading="lazy" decoding="async"
            />
            {item.tipo === 'reel' && (
              <span class="social-tipo" aria-label="Reel">
                <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><polygon points="5 3 13 8 5 13"/></svg>
              </span>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- ================= 10 · FAQ ================= -->
  <section class="section section--white" id="faq" aria-labelledby="faq-t">
    <div class="wrap">
      <div class="faq-grid">
        <div class="reveal">
          <p class="eyebrow">(08) Preguntas</p>
          <h2 id="faq-t">Lo que preguntan antes de la primera llamada.</h2>
          <p class="lead">Si falta algo, escríbenos y te lo contestamos por correo antes de agendar nada.</p>
        </div>
        <div class="reveal">
          {FAQ.map((f) => (
            <details>
              <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CTA FINAL ================= -->
  <section class="cta" id="contacto" aria-labelledby="cta-t">
    <div class="cta-media">
      <img src="/images/cta-boardroom.webp" alt="Sala de juntas en penumbra con vistas a la ciudad al atardecer" width="1800" height="2250" loading="lazy" decoding="async">
    </div>
    <div class="wrap">
      <p class="eyebrow eyebrow--dark">(09) Siguiente paso</p>
      <h2 id="cta-t">Reserva el diagnóstico.</h2>
      <p>Cuarenta y cinco minutos para revisar de dónde vienen hoy tus leads, qué te cuesta cada cliente y si tu zona sigue libre. Si no encajamos, te lo decimos en la misma videollamada.</p>
      <!-- Quién está al otro lado. La competencia ofrece "consultoría
           gratuita" sin decir con quién; poner cara y nombre junto al botón
           cambia el registro sin añadir ninguna promesa nueva. -->
      <div class="cta-who">
        <img src="/team/valeria.webp" alt="Retrato de Valeria Melero" width="640" height="961" loading="lazy" decoding="async">
        <p>
          <strong>Hablas con Valeria Melero</strong>
          <span>CEO &amp; Founder &mdash; no un comercial</span>
        </p>
      </div>
      <div class="cta-actions">
        <a class="btn btn--light" href={SITE.calendlyUrl} target="_blank" rel="noopener">Reservar diagnóstico
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9.5 4l4 4-4 4"/></svg>
        </a>
        <a class="cta-mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
      <p class="cta-note">Sin coste y sin compromiso.</p>
    </div>
  </section>

</main>

<Footer />

<script>
import EmblaCarousel from 'embla-carousel';

/* Carrusel de servicios con Embla.
   Antes era arrastre a mano sobre scrollLeft, con la inercia calculada
   también a mano. Nunca se sintió fluido: mover scrollLeft desde JavaScript
   pelea con el desplazamiento del propio navegador. Embla mueve la pista con
   transform y trae el arrastre, la inercia y el táctil resueltos, en 11 KB
   comprimidos.

   dragFree: sin puntos de anclaje. Estas tarjetas son un escaparate, no un
   visor de una en una, así que forzar el encaje daría tirones al soltar. */
document.addEventListener('astro:page-load', function () {
  var ventana = document.getElementById('svcScroll');
  var barra = document.getElementById('svcBar');
  if (!ventana) return;

  var embla = EmblaCarousel(ventana, {
    dragFree: true,
    containScroll: 'trimSnaps',
    align: 'start',
    skipSnaps: true,
    duration: 26,
  });

  embla.on('pointerDown', function () { ventana.classList.add('is-dragging'); });
  embla.on('pointerUp', function () { ventana.classList.remove('is-dragging'); });

  var tarjetas = [].slice.call(ventana.querySelectorAll('.svc-card'));
  var pista = ventana.querySelector('.svc-track');

  var pintar = function () {
    if (barra && pista) {
      var ratio = Math.min(1, Math.max(0.18, ventana.clientWidth / pista.scrollWidth));
      var avance = Math.min(1, Math.max(0, embla.scrollProgress()));
      barra.style.width = ratio * 100 + '%';
      barra.style.transform = 'translateX(' + avance * ((1 - ratio) / ratio) * 100 + '%)';
    }

    /* Profundidad: cada foto se desplaza dentro de su marco según dónde esté
       su tarjeta respecto al centro de la ventana. */
    var r = ventana.getBoundingClientRect();
    var centro = r.left + r.width / 2;
    tarjetas.forEach(function (c) {
      var img = c.querySelector('.svc-fig img');
      if (!img) return;
      var cr = c.getBoundingClientRect();
      var d = (cr.left + cr.width / 2 - centro) / r.width;
      img.style.transform = 'translate3d(' + (-d * 6.5).toFixed(2) + '%,0,0)';
    });
  };

  embla.on('scroll', pintar);
  embla.on('reInit', pintar);
  pintar();

  document.addEventListener('astro:before-swap', function () { embla.destroy(); }, { once: true });
});
</script>
</Layout>
