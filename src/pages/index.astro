---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import { SITE, STATS_BIG, SERVICES, PROCESO, COMPARISON, TESTIMONIALS, TEAM, FAQ } from '../config/site';

const ICONS: Record<string, string> = {
  trend: '<polyline points="3 17 9 11 13 15 21 7"></polyline><polyline points="15 7 21 7 21 13"></polyline>',
  chat: '<path d="M3 4h18l-6 8v6l-6 3v-9z"></path>',
  percent: '<circle cx="7" cy="7" r="3"></circle><circle cx="17" cy="17" r="3"></circle><line x1="19" y1="5" x2="5" y2="19"></line>',
  doc: '<path d="M5 3h9l5 5v13H5z"></path><polyline points="14 3 14 8 19 8"></polyline><line x1="9" y1="13" x2="15" y2="13"></line><line x1="9" y1="17" x2="15" y2="17"></line>',
  pencil: '<path d="M4 20h4L20 8l-4-4L4 16z"></path><line x1="14" y1="6" x2="18" y2="10"></line>',
  link: '<path d="M10 14a4 4 0 0 0 6 0l3-3a4 4 0 0 0-6-6l-1 1"></path><path d="M14 10a4 4 0 0 0-6 0l-3 3a4 4 0 0 0 6 6l1-1"></path>',
};

const TEAM_PHOTOS: Record<string, string> = {
  'Valeria Melero': '/team/valeria.jpg',
  'Yerai Jiménez': '/team/yerai.jpg',
  'Carlos Bernabé': '/team/carlos.jpg',
};
---

<Layout
  title="Melero Realty | Generación de Leads para Agencias Inmobiliarias"
  description="Creamos sistemas de captación de leads cualificados para agencias y asesores inmobiliarios en España y EEUU. Sin portales. Sin referidos. +300% ROI medio."
  includeFaqSchema={true}
>
  <Header />

  <main class="flex-1" style="overflow-x: hidden">

    <!-- ═══════════════════════════════
         HERO
    ════════════════════════════════ -->
    <section id="top" style="position: relative; background: var(--color-ink)">
      <div style="position: absolute; inset: 0" class="grayscale">
        <img
          src="/images/hero-villa.webp"
          alt=""
          style="width: 100%; height: 100%; object-fit: cover"
        />
      </div>
      <div style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15,14,13,.94) 0%, rgba(15,14,13,.72) 46%, rgba(15,14,13,.28) 100%); pointer-events: none"></div>

      <div style="position: relative; max-width: 1440px; margin: 0 auto; padding: 120px 16px 0; min-height: 82vh; display: flex; flex-direction: column; justify-content: flex-end" class="sm:px-8">
        <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 28px">
          <span style="width: 46px; height: 2px; background: var(--color-accent)"></span>
          <span style="font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #f3f2f2">Captación inmobiliaria · España &amp; EEUU</span>
        </div>
        <h1 style="margin: 0; max-width: 20ch; font-size: clamp(38px, 6.4vw, 104px); line-height: 0.96; letter-spacing: -0.03em; text-transform: uppercase; color: #f8f4f4">
          Si el 80% de tus leads vienen de un portal, tienes un problema.
        </h1>
        <p style="margin: 32px 0 0; max-width: 54ch; font-size: 18px; line-height: 1.5; color: rgba(248,244,244,.72)">
          {SITE.subtitulo}
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; margin: 40px 0 64px">
          <a class="btn btn-primary" href="/contacto" style="padding: 14px 24px; font-size: 15px">Agendar diagnóstico</a>
          <a class="btn" href="#comparativa" style="padding: 14px 24px; font-size: 15px; color: #f8f4f4; border-color: rgba(248,244,244,.4)">Ver la comparativa</a>
        </div>
      </div>

      <div style="position: relative; border-top: 2px solid rgba(248,244,244,.28); background: rgba(15,14,13,.72)">
        <div class="grid-3" style="max-width: 1440px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr)">
          {STATS_BIG.map(({ value, label }, i) => (
            <div style={`padding: 28px 24px; ${i < 2 ? 'border-right: 2px solid rgba(248,244,244,.28)' : ''}`}>
              <div style={`font-family: var(--font-heading); font-weight: 800; font-size: clamp(38px, 4.6vw, 68px); line-height: 1; letter-spacing: -0.03em; color: ${i === 2 ? 'var(--color-accent)' : '#f8f4f4'}`}>{value}</div>
              <div style="margin-top: 10px; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(248,244,244,.6)">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════
         DECLARACIÓN DE MARCA
    ════════════════════════════════ -->
    <section style="border-bottom: 2px solid var(--color-divider)">
      <div class="grid-2 sm:px-8" style="max-width: 1440px; margin: 0 auto; padding: 64px 16px; display: grid; grid-template-columns: 1.45fr 1fr; gap: 40px; align-items: end" data-reveal>
        <h2 style="margin: 0; font-size: clamp(28px, 3.4vw, 54px); line-height: 1.06; letter-spacing: -0.025em; max-width: 26ch">Hablamos de números, no de followers.</h2>
        <p style="margin: 0; font-size: 16px; line-height: 1.6; color: var(--color-muted)">Trabajamos con inmobiliarias y asesores que ya facturan y necesitan un canal propio de captación. No vendemos alcance: vendemos coste por lead, coste por cliente y retorno medible.</p>
      </div>
    </section>

    <!-- ═══════════════════════════════
         SERVICIOS
    ════════════════════════════════ -->
    <section id="servicios" style="border-bottom: 2px solid var(--color-divider)">
      <div style="max-width: 1440px; margin: 0 auto; padding: 72px 16px 0" class="sm:px-8" data-reveal>
        <div style="display: flex; align-items: baseline; gap: 16px; margin-bottom: 40px; flex-wrap: wrap">
          <span style="font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent)">01 / Servicios</span>
          <h2 style="margin: 0 0 0 auto; font-size: clamp(24px, 2.6vw, 40px); letter-spacing: -0.02em">El sistema, por partes</h2>
        </div>
      </div>
      <div class="grid-3" style="max-width: 1440px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 2px solid var(--color-divider); border-left: 2px solid var(--color-divider)" data-reveal>
        {SERVICES.map(({ icon, title, desc }, i) => (
          <div style="padding: 36px 24px 40px; border-right: 2px solid var(--color-divider); border-bottom: 2px solid var(--color-divider)">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="square" set:html={ICONS[icon]} />
              <span style="font-size: 12px; font-weight: 700; letter-spacing: 0.14em; color: color-mix(in srgb, var(--color-text) 40%, transparent)">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 style="margin: 0 0 12px; font-size: 21px; letter-spacing: -0.015em">{title}</h3>
            <p style="margin: 0; font-size: 15px; line-height: 1.55; color: var(--color-muted)">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════
         PROCESO
    ════════════════════════════════ -->
    <section id="proceso" style="border-bottom: 2px solid var(--color-divider)">
      <div style="max-width: 1440px; margin: 0 auto; padding: 72px 16px 88px" class="sm:px-8" data-reveal>
        <div style="display: flex; align-items: baseline; gap: 16px; margin-bottom: 48px; flex-wrap: wrap">
          <span style="font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent)">02 / Proceso</span>
          <h2 style="margin: 0 0 0 auto; font-size: clamp(24px, 2.6vw, 40px); letter-spacing: -0.02em">Cinco pasos, sin humo</h2>
        </div>
        <div style="border-top: 2px solid var(--color-divider)">
          {PROCESO.map(({ step, title, desc }, i) => (
            <div class="grid-2" style="display: grid; grid-template-columns: 90px 1.1fr 1.4fr; gap: 24px; padding: 26px 0; border-bottom: 2px solid var(--color-divider); align-items: start">
              <div style={`font-family: var(--font-heading); font-weight: 800; font-size: 36px; line-height: 1; letter-spacing: -0.03em; color: ${i === 0 ? 'var(--color-accent)' : 'color-mix(in srgb, var(--color-text) 30%, transparent)'}`}>{step}</div>
              <h3 style="margin: 0; font-size: 20px; letter-spacing: -0.015em">{title}</h3>
              <p style="margin: 0; font-size: 15px; line-height: 1.55; color: var(--color-muted)">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════
         POR QUÉ MELERO REALTY
    ════════════════════════════════ -->
    <section id="resultados" style="background: #1a1817; border-bottom: 2px solid var(--color-divider)">
      <div class="grid-2" style="max-width: 1440px; margin: 0 auto; padding: 64px 16px; display: grid; grid-template-columns: 1fr 1.35fr; gap: 40px; align-items: center" data-reveal>
          <div>
            <span style="font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent)">03 / Por qué</span>
            <h2 style="margin: 20px 0 18px; font-size: clamp(26px, 3vw, 46px); line-height: 1.04; letter-spacing: -0.025em; color: #f8f4f4">Por qué Melero Realty</h2>
            <p style="margin: 0 0 32px; font-size: 16px; line-height: 1.6; color: rgba(248,244,244,.66)">Especialización exclusiva en inmobiliario, acompañamiento 1:1 con la CEO y reporte semanal sobre las cifras que deciden: coste por lead, coste por cliente y ROI.</p>
            <div style="display: flex; flex-direction: column; gap: 12px">
              <div style="display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 2px solid rgba(248,244,244,.24)">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="square"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"></path><polyline points="9 12 11.5 14.5 16 10"></polyline></svg>
                <span style="font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #f8f4f4">Exclusividad por zona</span>
              </div>
              <div style="display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 2px solid rgba(248,244,244,.24)">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="square"><line x1="4" y1="20" x2="4" y2="10"></line><line x1="10" y1="20" x2="10" y2="4"></line><line x1="16" y1="20" x2="16" y2="13"></line><line x1="22" y1="20" x2="22" y2="7"></line></svg>
                <span style="font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #f8f4f4">Reporte semanal de KPIs</span>
              </div>
            </div>
          </div>
          <div>
            <VideoEmbed videoId={SITE.youtubeId} title="Por qué Melero Realty" />
          </div>
      </div>
    </section>

    <!-- ═══════════════════════════════
         COMPARATIVA
    ════════════════════════════════ -->
    <section id="comparativa" style="border-bottom: 2px solid var(--color-divider)">
      <div style="max-width: 1440px; margin: 0 auto; padding: 72px 16px 88px" class="sm:px-8" data-reveal>
        <div style="display: flex; align-items: baseline; gap: 16px; margin-bottom: 44px; flex-wrap: wrap">
          <span style="font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent)">04 / Comparativa</span>
          <h2 style="margin: 0 0 0 auto; font-size: clamp(24px, 2.6vw, 40px); letter-spacing: -0.02em">La diferencia, punto por punto</h2>
        </div>
        <div style="border-top: 2px solid var(--color-text); overflow-x: auto">
          <div class="grid-2" style="display: grid; grid-template-columns: 1fr 1fr; border-bottom: 2px solid var(--color-text); min-width: 480px">
            <div style="padding: 14px 20px; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-muted); border-right: 2px solid var(--color-divider)">Otras agencias</div>
            <div style="padding: 14px 20px; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent); background: var(--color-ink)">Melero Realty</div>
          </div>
          {COMPARISON.map(({ ellos, nosotros }) => (
            <div class="grid-2" style="display: grid; grid-template-columns: 1fr 1fr; border-bottom: 2px solid var(--color-divider); min-width: 480px">
              <div style="padding: 20px; font-size: 15px; line-height: 1.5; color: color-mix(in srgb, var(--color-text) 55%, transparent); border-right: 2px solid var(--color-divider); text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--color-text) 30%, transparent)">{ellos}</div>
              <div style="padding: 20px; font-size: 15px; line-height: 1.5; font-weight: 600">{nosotros}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════
         TESTIMONIOS
    ════════════════════════════════ -->
    <section id="testimonios" style="border-bottom: 2px solid var(--color-divider); background: var(--color-surface)">
      <div style="max-width: 1440px; margin: 0 auto; padding: 72px 16px 0" class="sm:px-8" data-reveal>
        <span style="font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent)">05 / Clientes</span>
      </div>
      <div class="grid-3" style="max-width: 1440px; margin: 40px auto 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 2px solid var(--color-divider)" data-reveal>
        {TESTIMONIALS.map(({ quote, name, role }, i) => (
          <div style={`padding: 36px 24px; ${i < 2 ? 'border-right: 2px solid var(--color-divider);' : ''} display: flex; flex-direction: column; gap: 28px`}>
            <p style="margin: 0; font-family: var(--font-heading); font-weight: 700; font-size: 19px; line-height: 1.35; letter-spacing: -0.015em">«{quote}»</p>
            <div style="margin-top: auto">
              <div style="width: 32px; height: 2px; background: var(--color-accent); margin-bottom: 14px"></div>
              <div style="font-size: 14px; font-weight: 700">{name}</div>
              <div style="font-size: 13px; color: var(--color-muted)">{role}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════
         EQUIPO
    ════════════════════════════════ -->
    <section id="equipo" style="border-bottom: 2px solid var(--color-divider)">
      <div style="max-width: 1440px; margin: 0 auto; padding: 72px 16px 0" class="sm:px-8" data-reveal>
        <div style="display: flex; align-items: baseline; gap: 16px; margin-bottom: 40px; flex-wrap: wrap">
          <span style="font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent)">06 / Equipo</span>
          <h2 style="margin: 0 0 0 auto; font-size: clamp(24px, 2.6vw, 40px); letter-spacing: -0.02em">Quién trabaja tu cuenta</h2>
        </div>
      </div>
      <div class="grid-3 sm:px-8" style="max-width: 1440px; margin: 0 auto; padding: 0 16px 88px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px" data-reveal>
        {TEAM.map(({ name, role, photo }) => (
          <figure style="margin: 0">
            <div class="grayscale" style="position: relative; aspect-ratio: 3/4; background: var(--color-surface); overflow: hidden">
              <img src={TEAM_PHOTOS[name] ?? photo} alt={name} style="width: 100%; height: 100%; object-fit: cover" loading="lazy" />
            </div>
            <figcaption style="margin: 0; padding-top: 16px; border-top: 2px solid var(--color-text)">
              <div style="font-family: var(--font-heading); font-weight: 800; font-size: 18px; letter-spacing: -0.015em">{name}</div>
              <div style="margin-top: 4px; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent)">{role}</div>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════
         FAQ
    ════════════════════════════════ -->
    <section id="faq" style="border-bottom: 2px solid var(--color-divider)">
      <div class="grid-2 sm:px-8" style="max-width: 1440px; margin: 0 auto; padding: 72px 16px 88px; display: grid; grid-template-columns: 0.6fr 1.4fr; gap: 40px" data-reveal>
          <div>
            <span style="font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent)">07 / FAQ</span>
            <h2 style="margin: 20px 0 0; font-size: clamp(24px, 2.6vw, 40px); line-height: 1.06; letter-spacing: -0.02em">Lo que preguntan antes de firmar</h2>
          </div>
          <div style="border-top: 2px solid var(--color-text)">
            {FAQ.map(({ q, a }) => (
              <details style="border-bottom: 2px solid var(--color-divider)">
                <summary style="display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 22px 0; font-family: var(--font-heading); font-weight: 700; font-size: 18px; letter-spacing: -0.01em">
                  {q}
                  <span class="faq-plus" style="flex: none; font-weight: 400; font-size: 24px; color: var(--color-accent)">+</span>
                </summary>
                <p style="margin: 0; padding: 0 40px 24px 0; font-size: 15px; line-height: 1.6; color: var(--color-muted)">{a}</p>
              </details>
            ))}
          </div>
        </div>
    </section>

    <!-- ═══════════════════════════════
         CONTACTO
    ════════════════════════════════ -->
    <section id="contacto" style="background: var(--color-ink)">
      <div style="max-width: 1440px; margin: 0 auto; padding: 72px 16px" class="sm:px-8" data-reveal>
        <div style="font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent)">08 / Empezar</div>
        <h2 style="margin: 24px 0 0; max-width: 24ch; font-size: clamp(34px, 6vw, 96px); line-height: 0.96; letter-spacing: -0.035em; text-transform: uppercase; color: #f8f4f4">Deja de alquilar tus leads.</h2>
        <div class="grid-2" style="margin-top: 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: end">
          <p style="margin: 0; max-width: 46ch; font-size: 17px; line-height: 1.6; color: rgba(248,244,244,.86)">Diagnóstico gratuito de tu captación actual. Si no vemos margen real de mejora, te lo decimos en la llamada.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 12px">
            <a class="btn btn-primary" href="/contacto" style="padding: 16px 26px; font-size: 15px">Agendar diagnóstico</a>
            <a class="btn" href={`mailto:${SITE.email}`} style="padding: 16px 26px; font-size: 15px; color: #f8f4f4; border-color: rgba(248,244,244,.5)">{SITE.email}</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
