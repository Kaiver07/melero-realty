---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import '../styles/home.css';
import { SITE, SERVICES, PROCESO, COMPARISON, TEAM, FAQ } from '../config/site';

/* Fotografía de los servicios, emparejada por índice con SERVICES.
   El copy vive en site.ts (fuente de verdad); aquí solo la imagen. */
const SERVICE_MEDIA = [
  { src: '/images/work-interior.jpg',   alt: 'Salón minimalista con sofás grises y chimenea encendida',      w: 1400, h: 933  },
  { src: '/images/conference.jpg',      alt: 'Sala de reuniones oscura con sillas de cuero y lámpara lineal', w: 2000, h: 3000 },
  { src: '/images/work-house.jpg',      alt: 'Casa moderna de hormigón y madera iluminada de noche',          w: 1400, h: 1400 },
  { src: '/images/work-interior-2.jpg', alt: 'Interior cálido con gran ventanal y una obra de arte',          w: 1400, h: 2100 },
  { src: '/images/hero-facade.jpg',     alt: 'Fachada blanca moderna con piscina bajo un cielo azul',         w: 2400, h: 1600 },
  { src: '/images/hero-villa-pool.jpg', alt: 'Villa moderna con piscina a la luz del atardecer',              w: 2400, h: 1350 },
];
---

<Layout title={SITE.name} includeFaqSchema={true}>


<!-- ================= 1 · HERO ================= -->
<header class="hero" id="top">
  <div class="hero-media">
    <img src="/images/hero-tower.jpg" alt="Skyline de una gran ciudad visto desde el agua a plena luz del día" width="2400" height="1600" fetchpriority="high" decoding="async">
  </div>
  <div class="hero-veil" aria-hidden="true"></div>

  <div class="hero-inner">
    <nav class="nav" aria-label="Principal">
      <a class="nav-brand" href="#top">Melero Realty</a>
      <ul class="nav-links">
        <li><a href="#servicios">Servicios</a></li>
        <li><a href="#proceso">Proceso</a></li>
        <li><a href="#equipo">Equipo</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>
      <a class="nav-mail" href="mailto:hola@valeriamelero.com">hola@valeriamelero.com</a>
    </nav>

    <div class="hero-spacer"></div>

    <div class="hero-word" aria-hidden="true"><span>M</span><span>E</span><span>L</span><span>E</span><span>R</span><span>O</span></div>

    <div class="hero-copy">
      <h1>Captación de leads para inmobiliarias<br>que ya están facturando.</h1>
      <p class="hero-support">Sistemas de captación de leads cualificados para negocios inmobiliarios en activo. Sin portales. Sin referidos. Sin curiosos.</p>
    </div>

    <!-- píldora de filtros: maquetada, sin lógica -->
    <div class="actionbar">
      <div class="ab-field">
        <span class="ab-label">Tipo de agencia</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5 8 10.5 12 6.5"/></svg>
      </div>
      <div class="ab-field">
        <span class="ab-label">Zona</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5 8 10.5 12 6.5"/></svg>
      </div>
      <div class="ab-field">
        <span class="ab-label">Facturación</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5 8 10.5 12 6.5"/></svg>
      </div>
      <a class="ab-btn" href="#contacto">Reservar diagnóstico</a>
    </div>
  </div>
</header>

<main>

  <!-- ================= 3 · INTRO ================= -->
  <section class="section section--paper" aria-labelledby="intro-t">
    <div class="wrap">
      <div class="intro-grid reveal">
        <div class="intro-side">
          <p class="eyebrow">(01) El servicio</p>
          <p>Trabajamos con inmobiliarias en activo y con exclusividad por zona: una sola marca por área de captación.</p>
        </div>
        <div>
          <h2 id="intro-t" class="intro-big">Creamos sistemas de captación de leads cualificados para negocios inmobiliarios en activo. Diseñamos el recorrido completo, del primer clic a la llamada agendada, y lo ajustamos semana a semana según coste por lead y calidad real. <em>Sin portales. Sin referidos. Sin curiosos.</em></h2>
        </div>
      </div>
      <div class="intro-rule" aria-hidden="true"></div>
    </div>
  </section>

  <!-- ================= 4 · SERVICIOS ================= -->
  <section class="section section--white svc" id="servicios" aria-labelledby="svc-t">
    <div class="wrap">
      <div class="svc-head reveal">
        <div>
          <p class="eyebrow">(02) Servicios</p>
          <h2 id="svc-t">Seis frentes, un solo objetivo: llamadas agendadas.</h2>
        </div>
        <p class="lead" style="max-width:34ch">Cada pieza existe para reducir el coste por cliente, no para llenar un informe.</p>
      </div>
    </div>

    <div class="wrap">
      <div class="svc-scroll" id="svcScroll" tabindex="0" role="region" aria-label="Servicios, desplazamiento horizontal">

        <article class="svc-card">
          <figure class="svc-fig"><img src="/images/work-interior.jpg" alt="Salón minimalista con sofás grises y chimenea encendida" width="1400" height="933" loading="lazy" decoding="async"></figure>
          <span class="svc-index">01</span>
          <h3>Paid Ads Inmobiliario</h3>
          <p>Campañas en Meta y Google diseñadas para captar propietarios y compradores cualificados. Sin presupuesto tirado.</p>
        </article>

        <article class="svc-card">
          <figure class="svc-fig"><img src="/images/conference.jpg" alt="Sala de reuniones oscura con sillas de cuero y lámpara lineal" width="2000" height="3000" loading="lazy" decoding="async"></figure>
          <span class="svc-index">02</span>
          <h3>Embudo de Captación</h3>
          <p>El recorrido completo: desde el primer clic hasta la llamada agendada. Sin fricción.</p>
        </article>

        <article class="svc-card">
          <figure class="svc-fig"><img src="/images/work-house.jpg" alt="Casa moderna de hormigón y madera iluminada de noche" width="1400" height="1400" loading="lazy" decoding="async"></figure>
          <span class="svc-index">03</span>
          <h3>Generación de Leads</h3>
          <p>Leads exclusivos para tu agencia. No compartidos, no comprados a terceros. Tuyos.</p>
        </article>

        <article class="svc-card">
          <figure class="svc-fig"><img src="/images/work-interior-2.jpg" alt="Interior cálido con gran ventanal y una obra de arte en la pared" width="1400" height="2100" loading="lazy" decoding="async"></figure>
          <span class="svc-index">04</span>
          <h3>Posicionamiento de Marca</h3>
          <p>La presencia digital que hace que los clientes elijan tu agencia antes de llamar a la competencia.</p>
        </article>

        <article class="svc-card">
          <figure class="svc-fig"><img src="/images/hero-facade.jpg" alt="Fachada blanca moderna con piscina bajo un cielo azul" width="2400" height="1600" loading="lazy" decoding="async"></figure>
          <span class="svc-index">05</span>
          <h3>Contenido Estratégico</h3>
          <p>Contenido que posiciona, educa y filtra. No publicaciones para rellenar el feed.</p>
        </article>

        <article class="svc-card">
          <figure class="svc-fig"><img src="/images/hero-villa-pool.jpg" alt="Villa moderna con piscina a la luz del atardecer" width="2400" height="1350" loading="lazy" decoding="async"></figure>
          <span class="svc-index">06</span>
          <h3>Estrategia y Consultoría</h3>
          <p>Para agencias que quieren entender qué está fallando en su captación y cómo arreglarlo.</p>
        </article>

      </div>
    </div>

    <div class="wrap">
      <div class="svc-bar" aria-hidden="true"><span class="svc-bar-fill" id="svcBar"></span></div>
      <div class="svc-foot">
        <a class="btn btn--dark" href="#contacto">Diagnóstico
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9.5 4l4 4-4 4"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= 5 · DATOS ================= -->
  <section class="section section--white" style="padding-top:0" aria-labelledby="facts-t">
    <div class="wrap">
      <h2 id="facts-t" class="brandline reveal">Hablamos de números, no de followers.</h2>
      <div class="facts reveal">
        <div class="fact">
          <p class="fact-num">3.200&nbsp;€</p>
          <p>Presupuesto mínimo para empezar. Por debajo de esa cifra no hay sistema que aguante.</p>
        </div>
        <div class="fact">
          <p class="fact-num">6 meses</p>
          <p>Duración del contrato. Los primeros resultados llegan hacia los 20 días; antes de 3 meses no garantizamos nada.</p>
        </div>
        <div class="fact">
          <p class="fact-num">1 marca</p>
          <p>Exclusividad por zona. Si trabajamos contigo, no trabajamos con tu competencia directa.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 6 · BANDA OSCURA ================= -->
  <section class="section band" aria-labelledby="band-t">
    <div class="wrap">
      <div class="band-grid">
        <div class="band-copy reveal">
          <p class="eyebrow eyebrow--dark">(03) El problema</p>
          <h2 id="band-t">Si el 80% de tus leads<br>vienen de un portal,<br>tienes un problema.</h2>
          <p>Un portal te alquila la demanda: el día que dejas de pagar, desaparece. Nosotros construimos el canal dentro de tu marca, para que el lead llegue a tu nombre y no al del portal, y para que puedas medir qué te cuesta cada cliente de verdad.</p>
          <p class="band-quote">Sin portales. Sin referidos. Sin curiosos.</p>
        </div>

        <div class="band-media reveal">
          <img src="/images/meeting.jpg" alt="Reunión de equipo en una oficina acristalada de tonos oscuros" width="2000" height="1333" loading="lazy" decoding="async">
          <div class="float-cards">
            <article class="fcard">
              <div class="fcard-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
              </div>
              <h3>Exclusividad por zona</h3>
              <p>Una sola marca por área de captación. No abrimos una segunda cuenta en tu mercado.</p>
            </article>
            <article class="fcard">
              <div class="fcard-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M6.5 21V12"/><path d="M12 21V4.5"/><path d="M17.5 21v-6.5"/></svg>
              </div>
              <h3>Reporte semanal</h3>
              <p>Coste por lead y coste por cliente, cada semana. Nada de impresiones ni alcance.</p>
            </article>
            <article class="fcard">
              <div class="fcard-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.4 2.7-5.6 6-5.6"/><circle cx="17" cy="11.2" r="2.4"/><path d="M13.4 20c0-2.4 1.6-4 3.6-4s3.6 1.6 3.6 4"/></svg>
              </div>
              <h3>Acompañamiento 1:1</h3>
              <p>Comunicación directa con la CEO durante todo el contrato. Sin capas intermedias.</p>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 7 · PROCESO ================= -->
  <!-- (04) Vídeo. Va aquí por dos motivos. Narrativo: el problema queda
       planteado justo antes, y la CEO lo explica antes de contar el método.
       Y de ritmo: la banda (#122f35) y el proceso (#0d2226) son dos planchas
       oscuras seguidas; esta sección clara las separa.
       Fachada de YouTube: solo se carga la miniatura y el iframe se inserta
       al pulsar. Sin JavaScript de framework y sin peticiones a YouTube en
       la carga inicial. -->
  <section class="section section--paper vid" id="video" aria-labelledby="vid-t">
    <div class="wrap vid-grid reveal">
      <div class="vid-copy">
        <p class="eyebrow">(04) En vídeo</p>
        <h2 id="vid-t">Por qué Melero Realty.</h2>
        <p class="vid-by">Valeria Melero &mdash; CEO &amp; Founder</p>
      </div>
      <div class="vid-media">
        <VideoEmbed
          videoId={SITE.youtubeId}
          title="Por qué Melero Realty — Valeria Melero"
        />
      </div>
    </div>
  </section>

  <section class="section proc" id="proceso" aria-labelledby="proc-t">
    <p class="proc-mark" aria-hidden="true">PROCESO</p>
    <div class="wrap">
      <div class="proc-head reveal">
        <p class="eyebrow eyebrow--dark">(05) Cómo trabajamos</p>
        <h2 id="proc-t">Cinco fases. Ninguna decorativa.</h2>
      </div>
      <ol class="steps reveal">
        {PROCESO.map((p) => (
          <li class="step">
            <span class="step-n">{p.step}</span>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================= 8 · COMPARATIVA ================= -->
  <section class="section section--white" aria-labelledby="cmp-t">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">(06) La diferencia</p>
        <h2 id="cmp-t" style="font-size:clamp(1.7rem,3.5vw,2.85rem);font-weight:600;margin-top:1.3rem;max-width:20ch;line-height:1.03">Lo que suele pasar, y lo que hacemos nosotros.</h2>

        <div class="cmp-head-row">
          <p class="cmp-h cmp-h--them">Otras agencias</p>
          <p class="cmp-h cmp-h--us">Melero Realty</p>
        </div>

        <div class="cmp">
        {COMPARISON.map((c) => (
          <>
            <div class="cmp-cell cmp-cell--them"><span class="cmp-tag">Otras agencias</span>{c.ellos}</div>
            <div class="cmp-cell cmp-cell--us"><span class="cmp-tag">Melero Realty</span>{c.nosotros}</div>
          </>
        ))}
        </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 9 · EQUIPO ================= -->
  <section class="section section--paper" id="equipo" style="padding-bottom:0" aria-labelledby="team-t">
    <div class="wrap team-head reveal">
      <p class="eyebrow">(07) Equipo</p>
      <h2 id="team-t">Tres personas, sin capas intermedias.</h2>
    </div>
    <div class="wrap">
    <div class="team-grid">
      {TEAM.map((m) => (
        <figure class="member">
          <img src={m.photo} alt={`Retrato de ${m.name}, ${m.role} de Melero Realty`}
               width="1000" height="1250" loading="lazy" decoding="async" />
          <figcaption>
            <span class="member-name">{m.name}</span>
            <span class="member-role">{m.role}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    </div>
  </section>

  <!-- ================= 10 · FAQ ================= -->
  <section class="section section--white" id="faq" aria-labelledby="faq-t">
    <div class="wrap">
      <div class="faq-grid">
        <div class="reveal">
          <p class="eyebrow">(08) Preguntas</p>
          <h2 id="faq-t">Lo que preguntan antes de la primera llamada.</h2>
          <p class="lead">Si falta algo, escríbenos y te lo contestamos por correo antes de agendar nada.</p>
        </div>
        <div class="reveal">
          {FAQ.map((f) => (
            <details>
              <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CTA FINAL ================= -->
  <!-- (08) Casting de modelos para reels. Audiencia distinta a la del resto
       de la página: aquí no se vende, se recluta. Por eso va en tono menor,
       sin botón sólido, para no competir con el CTA de diagnóstico. -->
  <section class="section section--paper casting" id="casting" aria-labelledby="casting-t">
    <div class="wrap casting-in reveal">
      <div>
        <p class="eyebrow">(09) Trabaja con nosotros</p>
        <h2 id="casting-t">Buscamos caras para nuestros reels.</h2>
      </div>
      <div class="casting-body">
        <p>
          Grabamos contenido en vídeo para inmobiliarias y para nuestra propia
          marca. Si te mueves bien delante de una cámara y quieres aparecer en
          esos reels, escríbenos.
        </p>
        <p class="casting-what">
          Cuéntanos quién eres, de dónde, tu Instagram y si tienes experiencia
          en cámara. No hace falta más.
        </p>
        <a class="casting-link" href="mailto:melero.realty@gmail.com?subject=Candidatura%20modelo%20para%20reels">
          Enviar candidatura
          <span aria-hidden="true">&#8594;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="cta" id="contacto" aria-labelledby="cta-t">
    <div class="cta-media">
      <img src="/images/cta-boardroom.jpg" alt="Sala de juntas en penumbra con vistas a la ciudad al atardecer" width="2000" height="2500" loading="lazy" decoding="async">
    </div>
    <div class="wrap">
      <p class="eyebrow eyebrow--dark">(10) Siguiente paso</p>
      <h2 id="cta-t">Reserva el diagnóstico.</h2>
      <p>Media hora para revisar de dónde vienen hoy tus leads, qué te cuesta cada cliente y si tu zona sigue libre. Si no encajamos, te lo decimos en la misma llamada.</p>
      <div class="cta-actions">
        <a class="btn btn--light" href="mailto:hola@valeriamelero.com?subject=Reservar%20diagn%C3%B3stico">Reservar diagnóstico
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9.5 4l4 4-4 4"/></svg>
        </a>
        <a class="cta-mail" href="mailto:hola@valeriamelero.com">hola@valeriamelero.com</a>
      </div>
    </div>
  </section>

</main>

<Footer />

<script>
(function(){
  var root = document.documentElement;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(!reduce) root.classList.add('js');

  /* Revelado por bloque (no por elemento) */
  if(!reduce && 'IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, {rootMargin:'0px 0px -8% 0px', threshold:0.08});
    document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){ el.classList.add('in'); });
  }

  /* Barra de progreso del carrusel de servicios */
  var track = document.getElementById('svcScroll');
  var fill  = document.getElementById('svcBar');
  if(track && fill){
    var update = function(){
      var max = track.scrollWidth - track.clientWidth;
      var ratio = Math.min(1, Math.max(0.18, track.clientWidth / track.scrollWidth));
      var progress = max > 0 ? track.scrollLeft / max : 0;
      fill.style.width = (ratio * 100) + '%';
      fill.style.transform = 'translateX(' + (progress * ((1 - ratio) / ratio) * 100) + '%)';
    };
    track.addEventListener('scroll', update, {passive:true});
    window.addEventListener('resize', update);
    update();
  }
})();
</script>
</Layout>
