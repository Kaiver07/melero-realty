---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogList from '../../components/BlogList.astro';
import BlogCta from '../../components/BlogCta.astro';
import { SITE, SERVICES, BLOG } from '../../config/site';
import { articulos, fecha, isoDia, minutos, type Articulo } from '../../lib/blog';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const todos = await articulos();
  return todos.map((post) => ({
    params: { slug: post.id },
    props: { post, todos },
  }));
}

interface Props {
  post: Articulo;
  todos: Articulo[];
}
const { post, todos } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const url = new URL(`/blog/${post.id}/`, SITE.url).href;
const publicado = isoDia(d.publishDate);
const modificado = isoDia(d.updatedDate ?? d.publishDate);

// En el orden de SERVICES, que es el de la home.
const servicios = SERVICES.filter((s) => d.servicios.includes(s.title));
const otros = todos.filter((p) => p.id !== post.id).slice(0, 3);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    image: new URL(d.image.src, SITE.url).href,
    datePublished: publicado,
    dateModified: modificado,
    inLanguage: 'es',
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      logo: { '@type': 'ImageObject', url: new URL('/logo-melero.png', SITE.url).href },
    },
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---

<Layout title={d.seoTitle ?? d.title} description={d.description} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={publicado} />
    <meta property="article:modified_time" content={modificado} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <Header />

  <main class="flex-1">
    <article>

      <header class="bl-hero">
        <div class="wrap">
          <p class="bl-eyebrow bl-eyebrow--dark"><a href="/blog/">{BLOG.antetitulo}</a></p>
          <div class="bl-hero-grid">
            <h1 class="bl-h1 bl-h1--post">{d.title}</h1>
            <div>
              <p class="bl-lead">{d.description}</p>
              <p class="bl-meta">
                <time datetime={publicado}>{fecha(d.publishDate)}</time>
                <span>{minutos(post.body)} min de lectura</span>
              </p>
            </div>
          </div>
        </div>
      </header>

      <div class="bl-post">
        <div class="wrap bl-split">
          <figure class="bl-fig">
            <img
              src={d.image.src}
              alt={d.image.alt}
              width={d.image.width}
              height={d.image.height}
              decoding="async"
            />
          </figure>
          <div class="bl-prose">
            <Content />
          </div>
        </div>
      </div>

    </article>

    {servicios.length > 0 && (
      <section class="bl-section bl-section--paper" aria-labelledby="bl-svcs-t">
        <div class="wrap bl-split">
          <div>
            <p class="bl-eyebrow">{BLOG.relacionadosAntetitulo}</p>
            <h2 id="bl-svcs-t" class="bl-h2">{BLOG.relacionados}</h2>
          </div>
          <div>
            <ul class="bl-svcs">
              {servicios.map((s) => (
                <li class="bl-svc">
                  <h3 class="bl-svc-title">{s.title}</h3>
                  <p class="bl-svc-desc">{s.desc}</p>
                </li>
              ))}
            </ul>
            <a class="bl-svc-link" href="/#servicios">{BLOG.verServicios}</a>
          </div>
        </div>
      </section>
    )}

    {otros.length > 0 && (
      <section class="bl-section bl-section--white" aria-labelledby="bl-otros-t">
        <div class="wrap">
          <h2 id="bl-otros-t" class="bl-h2">{BLOG.otros}</h2>
          <div class="bl-otros">
            <BlogList articulos={otros} nivel="h3" />
          </div>
        </div>
      </section>
    )}

    <BlogCta />
  </main>

  <Footer />
</Layout>

<style>
  .bl-otros { margin-top: clamp(2rem, 4vw, 3rem); }
</style>
